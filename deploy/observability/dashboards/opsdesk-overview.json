{
  "uid": "opsdesk-overview",
  "title": "OpsDesk - Service overview",
  "tags": [
    "opsdesk",
    "slo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "SLO snapshot (last 1h)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "API availability (1h)",
      "description": "SLO 99.5%: non-5xx / all requests",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - (sum(rate(http_server_request_duration_seconds_count{job=~\".*opsdesk-api.*\",namespace=\"$namespace\",route!~\"/|/ui|/healthz|/readyz|/metrics\",status_code=~\"5..\"}[1h])) / sum(rate(http_server_request_duration_seconds_count{job=~\".*opsdesk-api.*\",namespace=\"$namespace\",route!~\"/|/ui|/healthz|/readyz|/metrics\"}[1h])))",
          "legendFormat": "availability",
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Writes under 500 ms (1h)",
      "description": "SLO 95%",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
